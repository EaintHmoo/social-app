MONGO_USER=admin
MONGO_PASS=devpassword123
MONGO_URI=mongodb://admin:devpassword123@127.0.0.1:27017/myapp?authSource=admin
PORT=3000

# Laravel: this is your APP_KEY / JWT_SECRET in config/jwt.php.
# Used to sign & verify the short-lived ACCESS token — keep it secret, never commit a real one to git.
JWT_SECRET=dev_only_change_me_1a2b3c4d5e6f
JWT_EXPIRES_IN=15m

# Separate secret + longer expiry for the REFRESH token (used only against POST /auth/refresh).
# Keep this different from JWT_SECRET so leaking one doesn't compromise the other.
JWT_REFRESH_SECRET=dev_only_change_me_refresh_9z8y7x6w
JWT_REFRESH_EXPIRES_IN=7d
# Hard ceiling on one login, measured from the original login and NOT extended by rotation.
# Refreshing keeps a session alive indefinitely otherwise; past this the user must log in again.
JWT_SESSION_MAX_LIFETIME=30d

AWS_REGION=ap-southeast-1
AWS_ACCESS_KEY_ID=...
AWS_SECRET_ACCESS_KEY=...
S3_BUCKET=my-bucket
ASSET_BASE_URL=https://my-bucket.s3.ap-southeast-1.amazonaws.com